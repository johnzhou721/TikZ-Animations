\lua_load_module:n { pline-parametric-objects }
\NewDocumentCommand { \appendcurve } {o} {
    \group_begin:
    \tikzset{
        /pline/parametric/curve/.search~also = {/tikz}
        ,/pline/parametric/curve/.cd
        ,#1
    }
    \__pline_appendcurve:
    \group_end:
}
