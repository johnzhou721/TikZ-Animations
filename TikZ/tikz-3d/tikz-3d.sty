\NewDocumentCommand { \appendcurve } {o} {
    \begingroup
        \tikzset{
            /tikz-3d/parametric/curve/.search~also = {/tikz}
            ,/tikz-3d/parametric/curve/.cd
            ,#1
        }
        \__tikztd_appendcurve: {}
    \endgroup
}
