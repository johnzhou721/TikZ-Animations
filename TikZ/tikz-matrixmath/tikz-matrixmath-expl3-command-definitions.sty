% tikz-matrixmath-expl3-command-definitions.sty
\ProvidesExplFile
    {tikz-matrixmath-expl3-command-definitions}
    {2025/07/08}{1.0.0}{Test file}
\lua_load_module:n { tikz-matrixmath-parametric-objects }
\NewDocumentCommand { \appendcurve } {o} {
    \group_begin:
    \tikzset{
        /tikz-matrixmath/parametric/curve/.search~also = {/tikz}
        ,/tikz-matrixmath/parametric/curve/.cd
        ,#1
    }
    \__tikz_matrixmath_appendcurve:
    \group_end:
}
\NewDocumentCommand { \appendsurface } {o} {
    \group_begin:
    \tikzset{
        /tikz-matrixmath/parametric/surface/.search~also = {/tikz}
        ,/tikz-matrixmath/parametric/surface/.cd
        ,#1
    }
    \__tikz_matrixmath_appendsurface:
    \group_end:
}
\NewDocumentCommand { \rendersegments } {} {
    \__tikz_matrixmath_rendersegments:
}
\NewDocumentCommand { \appendplane } {o} {
    \group_begin:
    \tikzset{
        /tikz-matrixmath/clipped-subspace/plane/.search~also = 
            {/tikz-matrixmath/clipped-subspace}
        ,/tikz-matrixmath/clipped-subspace/plane/.cd
        ,#1
    }
    \__tikz_matrixmath_appendplane:
    \group_end:
}